# Shopify Application Credentials
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret_key
SHOPIFY_SCOPES=read_products,write_products

# App Host Information
HOST=https://your-tunnel-host.ngrok-free.app
PORT=3000
APP_SLUG=your-app-slug

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/shopify_app

# Encryption (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=your_64_character_hex_encryption_key_here_generate_with_crypto
